{
  "$schema": "../addon.schema.json",
  "api": 1,
  "id": "music",
  "name": "MusicRemote",
  "icon": "music.note",
  "requires": ["/var/jb/usr/bin/musicremote"],
  "conditions": [
    {
      "id": "state",
      "name": "Player State",
      "type": "choice",
      "exec": ["{jbroot}/usr/bin/musicremote", "state"],
      "cache": 5,
      "choices": {
        "playing": "Playing",
        "paused": "Paused",
        "stopped": "Stopped",
        "interrupted": "Interrupted",
        "seeking": "Seeking",
        "unknown": "Unknown"
      }
    }
  ],
  "actions": [
    {
      "command": "play",
      "name": "Play",
      "icon": "play.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "play"] }]
    },
    {
      "command": "pause",
      "name": "Pause",
      "icon": "pause.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "pause"] }]
    },
    {
      "command": "playpause",
      "name": "Play or Pause",
      "icon": "playpause.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "toggle"] }]
    },
    {
      "command": "next",
      "name": "Next Track",
      "icon": "forward.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "next"] }]
    },
    {
      "command": "prev",
      "name": "Previous Track",
      "icon": "backward.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "prev"] }]
    },
    {
      "command": "queue artist",
      "name": "Queue This Artist",
      "icon": "person.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "queue", "artist"] }]
    },
    {
      "command": "queue album",
      "name": "Queue This Album",
      "icon": "music.note",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "queue", "album"] }]
    },
    {
      "command": "append artist",
      "name": "Add This Artist to Queue",
      "icon": "text.badge.plus",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "queue", "artist", "--append"] }]
    },
    {
      "command": "append album",
      "name": "Add This Album to Queue",
      "icon": "text.badge.plus",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "queue", "album", "--append"] }]
    },
    {
      "command": "love",
      "name": "Love This Song",
      "icon": "heart.fill",
      "run": [{ "exec": ["{jbroot}/usr/bin/musicremote", "love", "toggle"] }],
      "banner": { "title": "Music", "icon": "heart.fill", "subtitle": "Love" }
    },
    {
      "command": "transfer",
      "name": "Transfer Playback",
      "icon": "arrow.up.right.circle.fill",
      "run": [
        {
          "exec": ["{jbroot}/usr/bin/musicremote", "transfer"],
          "if": { "var": "input", "unset": true },
          "as": "summary",
          "stopOnError": true
        },
        {
          "exec": ["{jbroot}/usr/bin/musicremote", "transfer", "{input}"],
          "as": "summary",
          "stopOnError": true
        }
      ],
      "banner": {
        "title": "Music",
        "icon": "arrow.up.right.circle.fill",
        "subtitle": "{summary}",
        "failed": "Transfer Failed"
      }
    },
    {
      "command": "pull",
      "name": "Pull Playback",
      "icon": "arrow.down.left.circle.fill",
      "run": [
        {
          "exec": ["{jbroot}/usr/bin/musicremote", "pull"],
          "if": { "var": "input", "unset": true },
          "as": "summary",
          "stopOnError": true
        },
        {
          "exec": ["{jbroot}/usr/bin/musicremote", "pull", "{input}"],
          "as": "summary",
          "stopOnError": true
        }
      ],
      "banner": {
        "title": "Music",
        "icon": "arrow.down.left.circle.fill",
        "subtitle": "{summary}",
        "failed": "Transfer Failed"
      }
    }
  ],
  "settings": [
    {
      "id": "target",
      "title": "Transfer Target",
      "type": "text",
      "domain": "com.saihgupr.musicremote.addon",
      "key": "target",
      "default": "Auto",
      "suggestions": ["Auto"],
      "suggestionsFile": "/var/mobile/Media/.musicremote/targets.json",
      "note": "RemoteCompanion SSH Host or Remote RC Client to hand off with. Auto picks the first iOS device configured in RemoteCompanion."
    },
    {
      "id": "overlap",
      "title": "Handoff Overlap",
      "type": "number",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "s",
      "domain": "com.saihgupr.musicremote.addon",
      "key": "overlap",
      "default": 1,
      "note": "Keep playing briefly on the sending device while the other device starts."
    },
    {
      "id": "always_play",
      "title": "Always Play on Target",
      "type": "switch",
      "domain": "com.saihgupr.musicremote.addon",
      "key": "alwaysPlay",
      "default": false,
      "note": "Start playing on the receiving device even when transferring while paused."
    }
  ]
}
